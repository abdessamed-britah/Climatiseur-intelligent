  {
    "id": "tpl_card",
    "type": "ui_template",
    "z": "tab_smartac",
    "group": "g_ctrl",
    "name": "AC status card",
    "order": 1,
    "width": 6,
    "height": 3,
    "format": "<style>\n  .ac-card{display:flex;align-items:center;gap:18px;padding:6px 4px}\n  .ac-icon{font-size:64px !important;line-height:64px;transition:color .4s}\n  .ac-icon.on{color:#29b6f6;animation:ac-spin 2s linear infinite;text-shadow:0 0 18px #29b6f6}\n  .ac-icon.off{color:#757575}\n  @keyframes ac-spin{from{transform:rotate(0)}to{transform:rotate(360deg)}}\n  .ac-title{font-size:22px;font-weight:700}\n  .ac-badge{display:inline-block;padding:2px 10px;border-radius:12px;font-size:12px;font-weight:700;color:#fff;margin:4px 6px 4px 0}\n  .ac-small{font-size:13px;opacity:.85}\n</style>\n<div class=\"ac-card\" ng-if=\"msg.payload\">\n  <i class=\"fa fa-snowflake-o ac-icon\" ng-class=\"msg.payload.ac ? 'on' : 'off'\"></i>\n  <div>\n    <div class=\"ac-title\">AC {{ msg.payload.ac ? 'RUNNING' : 'STOPPED' }}</div>\n    <span class=\"ac-badge\" ng-style=\"{'background': msg.payload.mode == 'AUTO' ? '#43a047' : '#fb8c00'}\">{{msg.payload.mode}}</span>\n    <span class=\"ac-badge\" ng-if=\"msg.payload.alarm\" style=\"background:#e53935\">T &gt; {{msg.payload.setpoint}} °C</span>\n    <span class=\"ac-badge\" ng-if=\"!msg.payload.sensorOk\" style=\"background:#e53935\">SENSOR ERROR</span>\n    <div class=\"ac-small\">ON above <b>{{msg.payload.setpoint | number:1}} °C</b> · OFF below <b>{{msg.payload.setpoint - msg.payload.hysteresis | number:1}} °C</b></div>\n  </div>\n</div>\n<div ng-if=\"!msg.payload\" class=\"ac-small\">Waiting for the ESP32...</div>\n",
    "storeOutMessages": true,
    "fwdInMessages": false,
    "resendOnRefresh": true,
    "templateScope": "local",
    "className": "",
    "x": 650,
    "y": 240,
    "wires": [
      []
    ]
