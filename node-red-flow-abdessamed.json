  {
    "id": "in_tele",
    "type": "mqtt in",
    "z": "tab_smartac",
    "name": "telemetry",
    "topic": "iot2026/smartac/abdessamed/telemetry",
    "qos": "1",
    "datatype": "json",
    "broker": "broker_hivemq",
    "nl": false,
    "rap": true,
    "rh": 0,
    "inputs": 0,
    "x": 140,
    "y": 220,
    "wires": [
      [
        "fn_parse"
      ]
    ]
  },
  {
    "id": "fn_parse",
    "type": "function",
    "z": "tab_smartac",
    "name": "Parse telemetry",
    "func": "// Split the JSON telemetry into one message per dashboard widget\nconst d = msg.payload;\nif (typeof d !== 'object' || d === null) return null;\n\nconst ok = d.sensorOk !== false && typeof d.temperature === 'number';\n\nconst temp  = ok ? { payload: d.temperature } : null;\nconst hum   = ok ? { payload: d.humidity } : null;\nconst chart = ok ? [\n    { topic: 'Temperature (°C)', payload: d.temperature },\n    { topic: 'Humidity (%)',     payload: d.humidity },\n    { topic: 'Threshold (°C)',   payload: d.setpoint }\n] : null;\nconst hi    = ok ? { payload: d.heatIndex.toFixed(1) + ' °C' } : { payload: '---' };\n\nconst card  = { payload: d };   // full object for the status card\n\nconst modeSw = { payload: d.mode };            // AUTO / MANUAL\nconst acSw   = { payload: d.ac ? 'ON' : 'OFF' };\nconst sp     = { payload: d.setpoint };\n\nconst rt = d.acRuntime || 0;\nconst h = Math.floor(rt / 3600), m = Math.floor((rt % 3600) / 60), s = rt % 60;\nconst runtime = { payload: `${h}h ${String(m).padStart(2,'0')}m ${String(s).padStart(2,'0')}s  (${d.switches} switchings)` };\n\nconst up = d.uptime || 0;\nconst sys = { payload: `RSSI ${d.rssi} dBm · uptime ${Math.floor(up/60)} min ${up%60} s` };\n\nnode.status({\n    fill: d.ac ? 'blue' : 'grey', shape: 'dot',\n    text: ok ? `${d.temperature}°C ${d.humidity}% · AC ${d.ac ? 'ON' : 'OFF'} · ${d.mode}` : 'sensor error'\n});\n\nreturn [temp, hum, chart, hi, card, modeSw, acSw, sp, runtime, sys];\n",
    "outputs": 10,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 360,
    "y": 220,
    "wires": [
      [
        "g_temp"
      ],
      [
        "g_hum"
      ],
      [
        "chart"
      ],
      [
        "txt_hi"
      ],
      [
        "tpl_card"
      ],
      [
        "sw_mode"
      ],
      [
        "sw_ac"
      ],
      [
        "sl_sp"
      ],
      [
        "txt_runtime"
      ],
      [
        "txt_sys"
      ]
    ]
  },
