    "format": "<style>\n .ev{width:100%;border-collapse:collapse;font-size:13px}\n .ev th{text-align:left;opacity:.7;border-bottom:1px solid #555;padding:3px}\n .ev td{padding:3px;border-bottom:1px solid #333}\n .t-AC_ON{color:#29b6f6;font-weight:700}.t-AC_OFF{color:#bdbdbd;font-weight:700}\n .t-SENSOR_ERROR,.t-REJECTED{color:#f44336;font-weight:700}\n</style>\n<table class=\"ev\">\n <tr><th>Time</th><th>Event</th><th>Detail</th><th>Temp</th></tr>\n <tr ng-repeat=\"e in msg.payload\"><td>{{e.time}}</td><td class=\"t-{{e.type}}\">{{e.type}}</td><td>{{e.detail}}</td><td>{{e.temp}}</td></tr>\n</table>\n<div ng-if=\"!msg.payload || msg.payload.length==0\" style=\"opacity:.6\">No events yet</div>\n",
