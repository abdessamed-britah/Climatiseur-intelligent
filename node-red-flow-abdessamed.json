    "type": "function",
    "z": "tab_smartac",
    "name": "Online / offline",
    "func": "const online = msg.payload === 'online';\nnode.status({fill: online ? 'green' : 'red', shape: 'dot', text: msg.payload});\nconst txt = { payload: online\n    ? '<span style=\"color:#4caf50\">● ONLINE</span>'\n    : '<span style=\"color:#f44336\">● OFFLINE</span>' };\nconst toast = online ? null : { topic: '⚠ Device offline', payload: 'The ESP32 lost its connection to the broker' };\nreturn [txt, toast];\n",
    "outputs": 2,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 380,
    "y": 820,
    "wires": [
