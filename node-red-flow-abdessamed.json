    "z": "tab_smartac",
    "name": "Events",
    "func": "const e = msg.payload;\nif (typeof e !== 'object' || e === null) return null;\n\n// keep the last 8 events for the log\nlet log = flow.get('eventLog') || [];\nlog.unshift({ time: new Date().toLocaleTimeString(), type: e.type, detail: e.detail,\n              temp: (e.temperature > -90 ? e.temperature + ' °C' : '-') });\nlog = log.slice(0, 8);\nflow.set('eventLog', log);\n\nlet toast = null;\nif (e.type === 'AC_ON')  toast = { topic: '❄ AC switched ON',  payload: e.detail };\nif (e.type === 'AC_OFF') toast = { topic: 'AC switched OFF',   payload: e.detail };\nif (e.type === 'SENSOR_ERROR') toast = { topic: '⚠ Sensor error', payload: e.detail };\n\nreturn [toast, { payload: log }];\n",
    "outputs": 2,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 350,
    "y": 900,
    "wires": [
      [
        "toast"
      ],
      [
        "tpl_log"
      ]
    ]
